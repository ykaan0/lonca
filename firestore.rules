rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }

    function isMember(gid) {
      return signedIn() && request.auth.uid in groupDoc(gid).memberIds;
    }

    function isLeader(gid) {
      return signedIn() && request.auth.uid == groupDoc(gid).leaderId;
    }

    function isStaff(gid) {
      return isLeader(gid) || (signedIn() && request.auth.uid in groupDoc(gid).helperIds);
    }

    function isMuted(gid) {
      return signedIn() && request.auth.uid in groupDoc(gid).mutedIds;
    }

    match /handles/{handle} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
    }

    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.leaderId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember(gid) && (
        isStaff(gid)
        // Kendi çalışma süresini eklerken veya ayrılırken
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['totalSeconds', 'memberIds', 'helperIds', 'mutedIds', 'memberCount'])
      );

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid) || isStaff(gid);
        allow update: if isSelf(uid) || isStaff(gid);
        allow delete: if isSelf(uid) || isStaff(gid);
      }

      match /requests/{uid} {
        allow read: if isSelf(uid) || isStaff(gid);
        allow create: if isSelf(uid) && !isMember(gid);
        allow delete: if isSelf(uid) || isStaff(gid);
      }

      match /sessions/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid) && isMember(gid);
        allow delete: if isSelf(uid) || isStaff(gid);
      }

      match /messages/{mid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && (
          (!isMuted(gid) && request.resource.data.system == false && request.resource.data.senderId == request.auth.uid)
          || (isStaff(gid) && request.resource.data.system == true)
        );
      }
    }
  }
}

